# Accounts — local defaults (copy to service/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/accounts
# Or sqlite for quick local smoke tests:
# DATABASE_URL=sqlite:///./accounts.db

AUTH_ISSUER=http://localhost:8001
AUTH_COOKIE_NAME=accounts_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_DAYS=30

# Production (set to your real domain):
# AUTH_ISSUER=https://accounts.example.com
# AUTH_COOKIE_DOMAIN=.example.com
# AUTH_COOKIE_SECURE=true
# AUTH_RSA_PRIVATE_KEY_PATH=/keys/private.pem
# AUTH_RSA_PUBLIC_KEY_PATH=/keys/public.pem

PASSWORD_RESET_FRONTEND_URL=http://localhost:5175
# RESEND_API_KEY=
EMAIL_FROM=noreply@localhost
APP_NAME=Accounts

# CORS_ORIGINS=https://tv.example.com,https://todos.example.com
# ADMIN_USER_IDS=1
# TVTRACKER_DATABASE_URL=postgresql://...
