# Nellits Accounts — local defaults (copy to service/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nellits_accounts
# Or sqlite for quick local smoke tests:
# DATABASE_URL=sqlite:///./accounts.db

AUTH_ISSUER=http://localhost:8001
AUTH_COOKIE_NAME=nellits_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_DAYS=30

# Production:
# AUTH_ISSUER=https://accounts.nellits.com
# AUTH_COOKIE_DOMAIN=.nellits.com
# AUTH_COOKIE_SECURE=true
# AUTH_RSA_PRIVATE_KEY_PATH=/keys/private.pem
# AUTH_RSA_PUBLIC_KEY_PATH=/keys/public.pem

PASSWORD_RESET_FRONTEND_URL=http://localhost:5175
# RESEND_API_KEY=
EMAIL_FROM=noreply@nellits.com
APP_NAME=Nellits

# CORS_ORIGINS=https://tv.nellits.com,https://todos.nellits.com
# ADMIN_USER_IDS=1
# TVTRACKER_DATABASE_URL=postgresql://...
